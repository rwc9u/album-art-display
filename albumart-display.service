[Unit]
Description=Album Art LED Matrix Display (shairport-sync MQTT -> RGB matrix)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Environment=RGBMATRIX_LIB=/home/rob/rpi-rgb-led-matrix/lib/librgbmatrix.so.1
EnvironmentFile=-/etc/albumart-display.env
WorkingDirectory=/home/rob/albumart-display
ExecStart=/usr/bin/bundle exec ruby bin/albumart-display
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
